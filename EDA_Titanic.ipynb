# %% [markdown]
# # Titanic Dataset - Exploratory Data Analysis
# 
# ## 1. Import Libraries
# %%
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
sns.set_style('whitegrid')

# %% [markdown]
# ## 2. Load Data
# %%
titanic = pd.read_csv('titanic.csv')

# %% [markdown]
# ## 3. Initial Data Exploration
# %%
# First 5 rows
titanic.head()

# %%
# Dataset info
titanic.info()

# %%
# Statistical summary
titanic.describe()

# %%
# Missing values
titanic.isnull().sum()

# %% [markdown]
# ## 4. Data Cleaning
# %%
# Fill missing age with median
titanic['Age'].fillna(titanic['Age'].median(), inplace=True)

# Drop cabin (too many missing values)
titanic.drop('Cabin', axis=1, inplace=True)

# Fill embarked with mode
titanic['Embarked'].fillna(titanic['Embarked'].mode()[0], inplace=True)

# %% [markdown]
# ## 5. Univariate Analysis
# %%
# Histograms
titanic.hist(figsize=(12,10))
plt.tight_layout()
plt.show()

# %%
# Count plots
plt.figure(figsize=(15,5))
plt.subplot(1,3,1)
sns.countplot(x='Pclass', data=titanic)
plt.title('Passenger Class Distribution')

plt.subplot(1,3,2)
sns.countplot(x='Sex', data=titanic)
plt.title('Gender Distribution')

plt.subplot(1,3,3)
sns.countplot(x='Survived', data=titanic)
plt.title('Survival Distribution')
plt.show()

# %% [markdown]
# ## 6. Bivariate Analysis
# %%
# Survival by class
sns.countplot(x='Pclass', hue='Survived', data=titanic)
plt.title('Survival by Passenger Class')
plt.show()

# %%
# Age distribution by survival
plt.figure(figsize=(10,6))
sns.boxplot(x='Survived', y='Age', data=titanic)
plt.title('Age Distribution by Survival Status')
plt.show()

# %%
# Fare vs Survival
plt.figure(figsize=(10,6))
sns.boxplot(x='Survived', y='Fare', data=titanic)
plt.title('Fare Distribution by Survival Status')
plt.show()

# %% [markdown]
# ## 7. Multivariate Analysis
# %%
# Pairplot
sns.pairplot(titanic[['Age', 'Fare', 'Pclass', 'Survived']], hue='Survived')
plt.show()

# %%
# Heatmap
plt.figure(figsize=(10,8))
sns.heatmap(titanic.corr(), annot=True, cmap='coolwarm')
plt.title('Correlation Heatmap')
plt.show()

# %% [markdown]
# ## 8. Key Findings
# 1. **Survival Rate**: Only about 38% passengers survived
# 2. **Class Impact**: 1st class had highest survival rate (63%), 3rd class lowest (24%)
# 3. **Gender Impact**: Females had much higher survival rate (74% vs 19% for males)
# 4. **Age**: Children (<10) had higher survival rate
# 5. **Fare**: Higher fare correlated with higher survival rate